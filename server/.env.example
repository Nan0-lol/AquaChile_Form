# Copia este archivo como ".env" (en la misma carpeta server/) y cambia los valores.
# El archivo .env NO se sube a GitHub; este .env.example sí, como guía.

# --- Usuario administrador ---
# En desarrollo puedes dejar esto comentado: se crean los usuarios de demo
# (admin, analista, evaluador, evaluador2, jefatura).
# En producción es OBLIGATORIO: se crea solo este administrador.
# ADMIN_USUARIO=reclutamiento
# ADMIN_PASSWORD=cambia-esta-clave-por-una-larga
# ADMIN_NOMBRE=Equipo Reclutamiento
# ADMIN_CORREO=reclutamiento@ejemplo.cl

# --- Servidor ---
# PORT=3001
# ORIGEN_PERMITIDO=http://localhost:5173
# TRUST_PROXY=1            # solo si se publica detrás de un proxy (Render, Railway)

# --- Límites (intentos cada 15 minutos por IP) ---
# LIMITE_LOGIN=10
# LIMITE_ENVIOS=60

# --- Correo ---
# Sin SMTP_HOST se usa Ethereal (correos de prueba que no llegan a nadie;
# la consola muestra un enlace para verlos).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Evaluaciones Psicolaborales <no-responder@ejemplo.cl>"
